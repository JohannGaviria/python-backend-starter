# --- Application metadata ---
APP_NAME=Python Backend Starter
APP_SUMMARY=Reusable Python backend starter API.
APP_DESCRIPTION=Reusable Python backend starter template with Docker, PostgreSQL, Redis, testing, and code quality tooling.

# --- Backend ---
DEBUG=True
ENVIRONMENT=development
BACKEND_PORT=8000
BACKEND_WORKERS=4
CORS_ALLOW_ORIGINS=http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# --- PostgreSQL (development) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_PORT=5432

# --- Database (development) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Redis (development) ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=20
REDIS_DECODE_RESPONSES=true

# --- Test infrastructure (docker compose --profile test) ---
# Separate containers and volumes, so the test run never touches the
# development database or cache. Used by the `backend-test` service.
# The hosts are the compose service names, so these URLs only resolve
# from inside the Docker network.
POSTGRES_TEST_USER=postgres_test
POSTGRES_TEST_PASSWORD=password
POSTGRES_TEST_DB=db_test
POSTGRES_TEST_PORT=5433
DATABASE_URL_TEST=postgresql+asyncpg://postgres_test:password@postgres-test:5432/db_test
REDIS_TEST_PORT=6380
REDIS_URL_TEST=redis://redis-test:6379/0
